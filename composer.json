{
	"name": "logicbrush/silverstripe-blog-utils",
	"description": "A collection of enhancements & utilities for the Silverstripe Blog module.",
	"homepage": "https://www.logicbrush.com/specialities/silverstripe-development/",
	"type": "silverstripe-vendormodule",
	"keywords": [
		"silverstripe",
		"blog"
	],
	"license": "BSD-3-Clause",
	"authors": [{
		"name": "John Learn",
		"email": "jflearn@logicbrush.com"
	}],
	"require": {
		"silverstripe/cms": "^6.0||6.x-dev",
		"silverstripe/blog": "^5.0||5.x-dev",
		"silverstripe/crontask": "^4.0||4.x-dev"
	},
	"require-dev": {
		"silverstripe/sqlite3": "dev-master",
		"phpunit/phpunit": "^11.0",
		"rector/rector": "^1.2",
		"logicbrush/metrics": "^1.0",
		"cmrcx/phptidy": "*"
	},
	"autoload": {
		"psr-4": {
			"Logicbrush\\BlogUtils\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Logicbrush\\BlogUtils\\Tests\\": "tests/"
		}
	},
	"extra": {
		"expose": [
			"client/dist"
		]
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"silverstripe/vendor-plugin": true
		}
	}
}
